                                    </UnityEngine.Localization.LocalVariable>
                                </variables>
                            </UnityEngine.Localization.LocalizedString>
                        </Bindings>
                    </ui:Label>
                    <ui:Button name="health-level-up-button" class="upgrade-button">
                        <ui:Label text="Level Up" style="height: 14px; align-content: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; color: rgb(255, 255, 255);">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:70598744974c8d84fa41e29bd60d80ed" entry="Id(27228080975872)" />
                            </Bindings>
                        </ui:Label>
                        <ui:VisualElement name="Cost-Container" style="flex-grow: 0; position: relative; bottom: auto; width: 100%; height: 23px; flex-shrink: 0; align-content: center; align-self: auto; margin-bottom: 0; margin-top: 3px; margin-right: 0; margin-left: 0;">
                            <ui:VisualElement name="BackgroundColor" style="flex-grow: 0; background-color: rgb(84, 152, 231); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 5px; flex-shrink: 0; width: 90%; height: 69%; align-self: center; color: rgb(80, 137, 204); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-direction: row; align-items: center;">
                                <ui:VisualElement style="flex-grow: 0; background-image: url(&quot;project://database/Assets/GUIPackCartoon/Sources/Icons/Icons%20Colored/PSD/Coin.psd?fileID=2800000&amp;guid=08557bbe25c2e413ea57256cd4f78fdd&amp;type=3#Coin&quot;); flex-shrink: 0; width: 15px; height: 15px;" />
                                <ui:Label text="0" style="color: rgb(255, 255, 255); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 2px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
